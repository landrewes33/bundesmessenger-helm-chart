# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Release Wrapper
RELEASE.md
# Gitlab
/.gitlab-ci*
.gitlab/
# Helm
.helmignore
helm-package/
# Filtering
/filter.txt
/filter_replace.txt
# Other
changelog.d/
towncrier.toml
/ci/
pusher-values.yaml
/docs/images/*.vsdx
/docs/images/*.jpg
