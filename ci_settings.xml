<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <localRepository/>
    <interactiveMode/>
    <usePluginRegistry/>
    <offline/>
    <pluginGroups/>
    <servers>
        <server>
            <id>central-proxy</id>
            <username>${deploy_username}</username>
            <password>${deploy_password}</password>
        </server>
        <server>
            <id>bwmessenger-extern</id>
            <username>${deploy_username}</username>
            <password>${deploy_password}</password>
        </server>
        <server>
            <id>bwmessenger-release</id>
            <username>${deploy_username}</username>
            <password>${deploy_password}</password>
        </server>
        <server>
            <id>bwmessenger-snapshot</id>
            <username>${deploy_username}</username>
            <password>${deploy_password}</password>
        </server>
    </servers>
    <mirrors/>
    <proxies>
        <!-- proxy>
            <id>dl-webproxy.example.com</id>
            <host>dl-webproxy.example.com</host>
            <port>3128</port>
            <nonProxyHosts>127.0.0.1|localhost|*.example.com</nonProxyHosts>
        </proxy -->
        <proxy>
            <id>pa-bwm-vm014.example.com</id>
            <host>pa-bwm-vm014.example.com</host>
            <port>3128</port>
            <nonProxyHosts>127.0.0.1|localhost|*.example.com</nonProxyHosts>
        </proxy>
    </proxies>
    <profiles>
        <profile>
            <id>nexus</id>
            <repositories>
                <repository>
                    <id>central-proxy</id>
                    <url>https://dl-nexus.example.com/repository/bwmessenger-maven/</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central-proxy</id>
                    <url>https://dl-nexus.example.com/repository/bwmessenger-maven/</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>nexus</activeProfile>
    </activeProfiles>
</settings>